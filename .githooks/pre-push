#!/bin/sh
# Refuse aussi les anciens commits : .gitignore ne protège pas l'historique.
set -eu
repo_root=$(git rev-parse --show-toplevel)
# Les sauvegardes internes de Replit ne sont pas des publications GitHub.
case "${2-}" in
  https://github.com/*|https://*@github.com/*|git@github.com:*|ssh://git@github.com/*) ;;
  *) exit 0 ;;
esac
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  if ! "$repo_root/scripts/check-confidential-paths.sh" history "$local_sha" "$remote_sha"; then
    echo "Push refusé : les nouveaux commits contiennent des chemins confidentiels." >&2
    echo "Retirez ces fichiers des commits à envoyer avant de pousser." >&2
    exit 1
  fi
done
