modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["clamav", "qpdf", "_7zz", "util-linux"]

[objectStorage]
defaultBucketID = "replit-objstore-5e7456db-566c-4a3b-b6fd-2f825410a3ee"

[userenv]

[userenv.shared]
MAIL_FROM = "conventions@soussmassa.ma"
SMTP_HOST = "mail.soussmassa.ma"
SMTP_PORT = "465"
SMTP_USER = "conventions@soussmassa.ma"
MAIL_ENABLED = "false"

[userenv.development]
MAIL_DEV_ENABLED = "true"
APP_PUBLIC_URL = "https://0812b685-7833-4a90-96ff-67728fa70575-00-2rjuse0r0udmv.riker.replit.dev"
MAIL_DEV_TEST_CONVENTION_ID = "162"
MAIL_DEV_TEST_RECIPIENT = "m.lmoussaoui@soussmassa.ma"

[userenv.production]
APP_PUBLIC_URL = "https://conventions-rsm.replit.app"
