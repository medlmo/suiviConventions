{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.mjs",
    "test:integration": "pnpm run build && node --test src/integration/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/organisation": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.10.0",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^11.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
